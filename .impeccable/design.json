  "narrative": {
    "northStar": "The Reference-Led Portfolio",
    "overview": "A calm, photographic portfolio grounded in the user-pinned Aditya Yadav reference: a wide sunset masthead, overlapping circular portrait, bold personal title, condensed section headings, and spacious project rows. Warm imagery supplies character while neutral surfaces keep professional content readable.\n\nThis specification records the completed replacement implementation in index.html, styles.css, and script.js. The reference supplies layout and typography authority; assets/SOURCES.md records the permitted new banner, the optimized user portrait, and illustrative project imagery. Values were extracted manually from code because the Impeccable engine download was blocked; no detector result or exact live-reference pixel fidelity is claimed.",
    "keyCharacteristics": [
      "Photographic masthead and overlapping portrait.",
      "Poppins titles, Bebas Neue sections, and Inter reading text.",
      "Flat sections, fine dividers, and generous project spacing.",
      "Dark default with a complete persisted light theme."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Switch the complete semantic palette together; keep the banner and portrait photographic in both themes.",
        "section": "colors"
      },
      {
        "name": "The Three Roles Rule",
        "body": "Use Poppins for identity and item titles, Bebas Neue for section headings, and Inter for reading text and metadata.",
        "section": "typography"
      },
      {
        "name": "The Portrait Depth Rule",
        "body": "Reserve the ambient shadow for the overlapping portrait; project rows and experience entries remain flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the pinned masthead, portrait overlap, type families, and responsive project-row geometry.",
      "Do use the supplied portrait and keep project photographs clearly illustrative.",
      "Do retain visible keyboard focus, meaningful link labels, and reduced-motion support."
    ],
    "donts": [
      "Don't replace the reference-led layout with a dashboard, card grid, or unrelated visual identity.",
      "Don't introduce decorative badges, invented project interface screenshots, or heavy card shadows."
    ]
  }
